# Qwen-Image-2.1-Turbo Windows 服务配置模板
# 复制为 .env 后修改。不要将 .env 提交代码仓库。

# ========== API 鉴权 ==========
# 启动时必须校验：禁止空值、默认占位符；请生成并替换为高强度随机密钥。
QWEN_API_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
MODEL_NAME=Qwen/Qwen-Image-2.1-Turbo

# ========== 模型与显存 ==========
MODEL_PATH=E:\model\qwen-image-2.1-turbo
# Optional models. Set absolute local directories to enable them.
QWEN_STANDARD_PATH=
MINIMAX_ENTROPACK_PATH=
MINIMAX_TEXT_ENCODER_PATH=
MINIMAX_IMAGE_ASSETS_PATH=
# int8, 7bit-int8 (dit_7bit_int8), or 3bpp
MINIMAX_PROFILE=int8
# Optional conditioning resolution limit for Qwen edits (e.g. 1024 for 2048 output).
QWEN_EDIT_REFERENCE_RESOLUTION=
MODEL_LOCAL_FILES_ONLY=true
MODEL_DTYPE=bfloat16
CPU_OFFLOAD=true
USE_KV_CACHE=true

# ========== HTTP 服务 ==========
# 默认只对本机开放；需要局域网访问时，配合防火墙白名单再修改为 0.0.0.0
HOST=127.0.0.1
PORT=8000
ENABLE_DOCS=false
# 留空即不开放跨域来源；多个 Origin 使用逗号分隔
CORS_ALLOWED_ORIGINS=

# ========== 推理限制 ==========
DEFAULT_IMAGE_SIZE=1024x1024
ALLOWED_IMAGE_SIZES=512x512,768x768,1024x1024,1024x768,768x1024,1152x768,768x1152,1024x576,576x1024
ENABLE_2048=false
MAX_IMAGES_PER_REQUEST=1
MAX_CONCURRENT_INFERENCES=1
MAX_QUEUE_LENGTH=3
QUEUE_WAIT_TIMEOUT_SECONDS=120
REQUEST_TIMEOUT_SECONDS=600
MAX_PROMPT_LENGTH=4000

# ========== 图片上传 ==========
MAX_UPLOAD_MB=20
MAX_IMAGE_PIXELS=25000000
ALLOWED_UPLOAD_FORMATS=PNG,JPEG,WEBP
SAVE_UPLOADS=false
UPLOAD_DIR=D:\AI\QwenImageAPI\uploads

# ========== 图片输出 ==========
DEFAULT_RESPONSE_FORMAT=b64_json
SAVE_OUTPUTS=true
OUTPUT_DIR=D:\AI\QwenImageAPI\outputs
OUTPUT_RETENTION_DAYS=7
ENABLE_URL_RESPONSE=false

# ========== 日志 ==========
LOG_DIR=D:\AI\QwenImageAPI\logs
LOG_LEVEL=INFO
LOG_RETENTION_DAYS=30
LOG_PROMPTS=false
LOG_JSON=true
